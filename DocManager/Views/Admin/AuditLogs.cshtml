@{
    ViewData["Title"] = "Nhật ký hệ thống";
    // Ép kiểu dữ liệu từ ViewBag
    var logs = ViewBag.AuditLogs as IEnumerable<dynamic>;
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history text-primary me-2"></i> Nhật ký Truy cập & Tải tài liệu</h2>
        <a asp-controller="Admin" asp-action="PendingApprovals" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại duyệt văn bản
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Thời gian</th>
                            <th>Người dùng</th>
                            <th>Hành động</th>
                            <th>Văn bản</th>
                            <th>IP Thiết bị</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (logs == null || !logs.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                                    Chưa có dữ liệu lịch sử nào được ghi nhận.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in logs)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <strong>@item.Timestamp.ToString("dd/MM/yyyy")</strong><br />
                                        <small class="text-muted">@item.Timestamp.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">
                                            <i class="bi bi-person-circle"></i> @item.UserName
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.ActionType == "Download")
                                        {
                                            <span class="badge bg-success text-white"><i class="bi bi-download"></i> Tải về</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark"><i class="bi bi-eye"></i> @item.ActionType</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@item.DocumentNumber</strong><br />
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;" title="@item.DocumentTitle">
                                            @item.DocumentTitle
                                        </small>
                                    </td>
                                    <td>
                                        <code>@item.IPAddress</code>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>