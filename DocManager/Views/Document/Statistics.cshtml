@model DocManager.Models.DocumentStatisticsViewModel

@{
    ViewData["Title"] = "Thống kê Hệ thống";
}

<div class="container my-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold">
                <i class="fas fa-chart-pie text-primary me-2"></i>Thống kê Hệ thống Tài liệu
            </h2>
            <p class="text-muted">
                <i class="fas fa-calendar-alt me-1"></i> Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-outline-primary" onclick="location.reload()">
                <i class="fas fa-sync-alt me-1"></i>Làm mới
            </button>
            <a asp-action="Index" class="btn btn-primary">
                <i class="fas fa-arrow-left me-1"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- 4 Card thống kê tổng quan -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title opacity-75">Tổng tài liệu</h6>
                            <h2 class="fw-bold mb-0">@Model.TotalDocuments</h2>
                        </div>
                        <i class="fas fa-folder-open fa-3x opacity-50"></i>
                    </div>
                    <div class="mt-3">
                        <small class="opacity-75">
                            <i class="fas fa-arrow-up me-1"></i> +@Model.DocumentsByMonth.Count tài liệu mới
                        </small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title opacity-75">Văn bản đến</h6>
                            <h2 class="fw-bold mb-0">@(Model.DocumentsByCategory.ContainsKey("Văn bản đến") ? Model.DocumentsByCategory["Văn bản đến"] : 0)</h2>
                        </div>
                        <i class="fas fa-inbox fa-3x opacity-50"></i>
                    </div>
                    <div class="mt-3">
                        <small class="opacity-75">
                            <i class="fas fa-file-alt me-1"></i> Văn bản đến
                        </small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title opacity-75">Văn bản đi</h6>
                            <h2 class="fw-bold mb-0">@(Model.DocumentsByCategory.ContainsKey("Văn bản đi") ? Model.DocumentsByCategory["Văn bản đi"] : 0)</h2>
                        </div>
                        <i class="fas fa-file-export fa-3x opacity-50"></i>
                    </div>
                    <div class="mt-3">
                        <small class="opacity-75">
                            <i class="fas fa-file-alt me-1"></i> Văn bản đi
                        </small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <div class="card-body text-dark">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title opacity-75">Công văn</h6>
                            <h2 class="fw-bold mb-0">@(Model.DocumentsByCategory.ContainsKey("Công văn") ? Model.DocumentsByCategory["Công văn"] : 0)</h2>
                        </div>
                        <i class="fas fa-envelope fa-3x opacity-50"></i>
                    </div>
                    <div class="mt-3">
                        <small class="opacity-75">
                            <i class="fas fa-file-alt me-1"></i> Công văn
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ và thống kê chi tiết -->
    <div class="row g-4">
        <!-- Biểu đồ tròn - Phân loại theo nhóm -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 h-100">
                <div class="card-header bg-gradient-primary text-white rounded-top-4" style="background: linear-gradient(135deg, #0b5e7c 0%, #1a7a9e 100%);">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-chart-pie me-2"></i>Phân loại theo Nhóm
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.DocumentsByCategory.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-pie fa-3x text-muted mb-3 d-block"></i>
                            <p class="text-muted">Chưa có dữ liệu để hiển thị</p>
                        </div>
                    }
                    else
                    {
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="categoryChart"></canvas>
                        </div>
                        <div class="mt-3">
                            @foreach (var item in Model.DocumentsByCategory)
                            {
                                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                    <span>
                                        <span class="badge rounded-circle me-2" style="background: @GetColorForCategory(item.Key); width: 12px; height: 12px; display: inline-block;"></span>
                                        @item.Key
                                    </span>
                                    <span class="fw-bold">@item.Value</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Biểu đồ cột - Theo tháng -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 h-100">
                <div class="card-header bg-gradient-success text-white rounded-top-4" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-chart-bar me-2"></i>Số lượng theo Tháng ban hành
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.DocumentsByMonth.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-bar fa-3x text-muted mb-3 d-block"></i>
                            <p class="text-muted">Chưa có dữ liệu để hiển thị</p>
                        </div>
                    }
                    else
                    {
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="monthChart"></canvas>
                        </div>
                        <div class="mt-3">
                            <div class="row g-2">
                                @foreach (var item in Model.DocumentsByMonth)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                                            <span class="small">@item.Key</span>
                                            <span class="badge bg-primary rounded-pill">@item.Value</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Thống kê nâng cao -->
        <div class="col-12">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-gradient-info text-white rounded-top-4" style="background: linear-gradient(135deg, #2193b0 0%, #6dd5ed 100%);">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-chart-line me-2"></i>Thống kê nâng cao
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-3 col-6">
                            <div class="text-center p-3 bg-light rounded-3">
                                <i class="fas fa-calendar-check fa-2x text-primary mb-2"></i>
                                <h6 class="text-muted mb-1">Tài liệu mới nhất</h6>
                                <p class="fw-bold mb-0">@(Model.DocumentsByMonth.Count > 0 ? Model.DocumentsByMonth.Keys.LastOrDefault() : "N/A")</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="text-center p-3 bg-light rounded-3">
                                <i class="fas fa-users fa-2x text-success mb-2"></i>
                                <h6 class="text-muted mb-1">Người phụ trách</h6>
                                <p class="fw-bold mb-0">@(Model.DocumentsByCategory.Count > 0 ? Model.DocumentsByCategory.Count : 0)</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="text-center p-3 bg-light rounded-3">
                                <i class="fas fa-file-pdf fa-2x text-danger mb-2"></i>
                                <h6 class="text-muted mb-1">Tài liệu có file</h6>
                                <p class="fw-bold mb-0">@Model.TotalDocuments</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="text-center p-3 bg-light rounded-3">
                                <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                                <h6 class="text-muted mb-1">Tháng có nhiều nhất</h6>
                                <p class="fw-bold mb-0">@(Model.DocumentsByMonth.Count > 0 ? Model.DocumentsByMonth.OrderByDescending(x => x.Value).FirstOrDefault().Key : "N/A")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts cho biểu đồ -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Biểu đồ tròn - Phân loại theo nhóm
            @if (Model.DocumentsByCategory.Count > 0)
            {
                <text>
                const categoryCtx = document.getElementById('categoryChart').getContext('2d');
                const categoryData = {
                    labels: [@Html.Raw(string.Join(",", Model.DocumentsByCategory.Select(kvp => $"'{kvp.Key}'")))],
                    datasets: [{
                        data: [@Html.Raw(string.Join(",", Model.DocumentsByCategory.Select(kvp => kvp.Value)))],
                        backgroundColor: [
                            '#667eea', '#764ba2', '#f093fb', '#f5576c',
                            '#4facfe', '#00f2fe', '#43e97b', '#38f9d7',
                            '#fa709a', '#fee140'
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                };
                
                new Chart(categoryCtx, {
                    type: 'doughnut',
                    data: categoryData,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    usePointStyle: true,
                                    pointStyle: 'circle'
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        let percentage = ((context.parsed / total) * 100).toFixed(1);
                                        return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        },
                        cutout: '60%'
                    }
                });
                </text>
            }

            // Biểu đồ cột - Theo tháng
            @if (Model.DocumentsByMonth.Count > 0)
            {
                <text>
                const monthCtx = document.getElementById('monthChart').getContext('2d');
                const monthData = {
                    labels: [@Html.Raw(string.Join(",", Model.DocumentsByMonth.Select(kvp => $"'{kvp.Key}'")))],
                    datasets: [{
                        label: 'Số lượng tài liệu',
                        data: [@Html.Raw(string.Join(",", Model.DocumentsByMonth.Select(kvp => kvp.Value)))],
                        backgroundColor: [
                            'rgba(102, 126, 234, 0.8)',
                            'rgba(118, 75, 162, 0.8)',
                            'rgba(240, 147, 251, 0.8)',
                            'rgba(245, 87, 108, 0.8)',
                            'rgba(79, 172, 254, 0.8)',
                            'rgba(0, 242, 254, 0.8)',
                            'rgba(67, 233, 123, 0.8)',
                            'rgba(56, 249, 215, 0.8)',
                            'rgba(250, 112, 154, 0.8)',
                            'rgba(254, 225, 64, 0.8)'
                        ],
                        borderColor: [
                            '#667eea', '#764ba2', '#f093fb', '#f5576c',
                            '#4facfe', '#00f2fe', '#43e97b', '#38f9d7',
                            '#fa709a', '#fee140'
                        ],
                        borderWidth: 2,
                        borderRadius: 5
                    }]
                };
                
                new Chart(monthCtx, {
                    type: 'bar',
                    data: monthData,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return 'Số lượng: ' + context.parsed.y;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1
                                }
                            }
                        }
                    }
                });
                </text>
            }
        });

        // Hàm lấy màu cho category
        function getColorForCategory(category) {
            const colors = {
                'Văn bản đến': '#667eea',
                'Văn bản đi': '#764ba2',
                'Công văn': '#4facfe',
                'Thông báo': '#43e97b',
                'Nghị quyết': '#f5576c',
                'Quyết định': '#fa709a'
            };
            return colors[category] || '#6c757d';
        }
    </script>
}

<!-- Helper function cho màu sắc -->
@functions {
    public string GetColorForCategory(string category)
    {
        var colors = new Dictionary<string, string>
        {
            { "Văn bản đến", "#667eea" },
            { "Văn bản đi", "#764ba2" },
            { "Công văn", "#4facfe" },
            { "Thông báo", "#43e97b" },
            { "Nghị quyết", "#f5576c" },
            { "Quyết định", "#fa709a" }
        };
        return colors.ContainsKey(category) ? colors[category] : "#6c757d";
    }
}