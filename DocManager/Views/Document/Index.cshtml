@model IEnumerable<DocManager.Models.Document>
@{
    // Nhận danh sách ID đã thích từ Controller
    var favIds = ViewBag.FavoriteDocIds as List<int> ?? new List<int>();
}
@{
    ViewData["Title"] = "Quản lý & Tra cứu Văn bản";
}

<div class="container my-4">
    <!-- Header với thống kê -->
    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <h2 class="mb-0 fw-bold">
                <i class="fas fa-folder-open text-primary me-2"></i>Quản lý & Tra cứu Văn bản Nội bộ
            </h2>
            <p class="text-muted mt-1">
                <i class="fas fa-database me-1"></i> Tổng số: <strong>@Model.Count()</strong> tài liệu
            </p>
        </div>
        <div class="col-md-4 text-end">
            
            {
                <a asp-action="Create" class="btn btn-primary btn-lg px-4 shadow-sm" style="background: linear-gradient(135deg, #0b5e7c 0%, #1a7a9e 100%); border: none;">
                    <i class="fas fa-plus-circle me-2">Thêm mới</i>
                </a>
            }
        </div>
    </div>

    <!-- Thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-file-alt fa-2x text-primary"></i>
                    <h5 class="mt-2 mb-0">@Model.Count(d => d.Category == "Văn bản đến")</h5>
                    <small class="text-muted">Văn bản đến</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-file-export fa-2x text-success"></i>
                    <h5 class="mt-2 mb-0">@Model.Count(d => d.Category == "Văn bản đi")</h5>
                    <small class="text-muted">Văn bản đi</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-envelope fa-2x text-info"></i>
                    <h5 class="mt-2 mb-0">@Model.Count(d => d.Category == "Công văn")</h5>
                    <small class="text-muted">Công văn</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-bullhorn fa-2x text-warning"></i>
                    <h5 class="mt-2 mb-0">@Model.Count(d => d.Category == "Thông báo")</h5>
                    <small class="text-muted">Thông báo</small>
                </div>
            </div>
        </div>
    </div>

    <!-- BỘ LỌC NÂNG CAO -->
    <div class="card border-0 shadow-lg mb-4 rounded-4">
        <div class="card-header bg-gradient-primary text-white rounded-top-4" style="background: linear-gradient(135deg, #0b5e7c 0%, #1a7a9e 100%);">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-sliders-h me-2"></i>Bộ lọc Tra cứu Nâng cao
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Index" method="get" id="filterForm">
                <div class="row g-3">
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-search text-primary me-1"></i>Từ khóa
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-keyboard text-primary"></i>
                            </span>
                            <input type="text" name="searchString" value="@ViewData["CurrentSearch"]"
                                   class="form-control border-start-0" placeholder="Nhập từ khóa cần tìm..." />
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-tag text-primary me-1"></i>Loại văn bản
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-folder-open text-primary"></i>
                            </span>
                            <select name="category" class="form-select border-start-0">
                                <option value="">-- Tất cả loại --</option>
                                <option value="Văn bản đến" selected="@(ViewData["CurrentCategory"]?.ToString() == "Văn bản đến")">📥 Văn bản đến</option>
                                <option value="Văn bản đi" selected="@(ViewData["CurrentCategory"]?.ToString() == "Văn bản đi")">📤 Văn bản đi</option>
                                <option value="Công văn" selected="@(ViewData["CurrentCategory"]?.ToString() == "Công văn")">📩 Công văn</option>
                                <option value="Thông báo" selected="@(ViewData["CurrentCategory"]?.ToString() == "Thông báo")">📢 Thông báo</option>
                                <option value="Nghị quyết" selected="@(ViewData["CurrentCategory"]?.ToString() == "Nghị quyết")">📜 Nghị quyết</option>
                                <option value="Quyết định" selected="@(ViewData["CurrentCategory"]?.ToString() == "Quyết định")">⚖️ Quyết định</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt text-primary me-1"></i>Từ ngày
                        </label>
                        <input type="date" name="fromDate" value="@ViewData["FromDate"]" class="form-control" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt text-primary me-1"></i>Đến ngày
                        </label>
                        <input type="date" name="toDate" value="@ViewData["ToDate"]" class="form-control" />
                    </div>
                    <div class="col-lg-1 col-md-12 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100 shadow-sm">
                            <i class="fas fa-search me-1"></i>Tìm
                        </button>
                    </div>
                </div>

                <!-- Nút xóa lọc -->
                @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()) ||
                     !string.IsNullOrEmpty(ViewData["CurrentCategory"]?.ToString()) ||
                     !string.IsNullOrEmpty(ViewData["FromDate"]?.ToString()) ||
                     !string.IsNullOrEmpty(ViewData["ToDate"]?.ToString()))
                {
                    <div class="mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-times me-1"></i>Xóa bộ lọc
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="documentTable">
                    <thead style="background: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                        <tr>
                            <th class="text-center" style="width: 60px;">Yêu thích</th>
                            <th class="py-3 px-4" style="min-width: 120px;">
                                <i class="fas fa-hashtag text-muted me-1"></i>Số VB
                            </th>
                            <th class="py-3" style="min-width: 250px;">
                                <i class="fas fa-heading text-muted me-1"></i>Tên tài liệu
                            </th>
                            <th class="py-3" style="min-width: 130px;">
                                <i class="fas fa-tag text-muted me-1"></i>Loại
                            </th>
                            <th class="py-3" style="min-width: 130px;">
                                <i class="fas fa-calendar-day text-muted me-1"></i>Ngày ban hành
                            </th>
                            <th class="py-3" style="min-width: 140px;">
                                <i class="fas fa-user text-muted me-1"></i>Phụ trách
                            </th>
                            <th class="py-3 text-center" style="min-width: 80px;">
                                <i class="fas fa-qrcode text-muted me-1"></i>QR
                            </th>
                            <th class="py-3 text-center" style="min-width: 380px;">
                                <i class="fas fa-cog text-muted me-1"></i>Hành động
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                                    <h5 class="text-muted">Không tìm thấy tài liệu nào phù hợp</h5>
                                    <p class="text-muted small">Hãy thử thay đổi bộ lọc hoặc thêm tài liệu mới</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm border-0 bg-transparent shadow-none" onclick="toggleStar(@item.Id)">
                                            @if (favIds.Contains(item.Id))
                                            {
                                                <i class="bi bi-star-fill text-warning fs-5" id="star-@item.Id"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-secondary fs-5" id="star-@item.Id"></i>
                                            }
                                        </button>
                                    </td>
                                    <td class="px-4">
                                        <span class="fw-bold text-primary">@item.DocumentNumber</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.Title</div>
                                        <small class="text-muted text-truncate d-block" style="max-width: 300px;">@item.Content</small>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2
                                            @(item.Category == "Văn bản đến" ? "bg-primary" :
                                              item.Category == "Văn bản đi" ? "bg-success" :
                                              item.Category == "Công văn" ? "bg-info" :
                                              item.Category == "Thông báo" ? "bg-warning" :
                                              item.Category == "Nghị quyết" ? "bg-danger" :
                                              "bg-secondary")">
                                            @item.Category
                                        </span>
                                    </td>
                                    <td>@item.IssueDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.PersonInCharge</td>

                                    <!-- MÃ QR -->
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.FilePath))
                                        {
                                            var downloadUrl = Url.Action("Download", "Document", new { filePath = item.FilePath }, Context.Request.Scheme);
                                            <img src="@Url.Action("GenerateQRCode", "Document", new { text = downloadUrl })"
                                                 alt="QR Code" width="60" height="60"
                                                 class="border rounded-2 shadow-sm bg-white p-1"
                                                 style="cursor: pointer; transition: transform 0.2s;"
                                                 onmouseover="this.style.transform='scale(1.1)'"
                                                 onmouseout="this.style.transform='scale(1)'"
                                                 onclick="zoomQr(this.src)" />
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="fas fa-minus"></i></span>
                                        }
                                    </td>

                                    <!-- NÚT HÀNH ĐỘNG - HIỂN THỊ ĐẦY ĐỦ CHỮ -->
                                    <td class="text-center">
                                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                                            <!-- Nút Xem PDF -->
                                            @if (!string.IsNullOrEmpty(item.FilePath) && item.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-info" onclick="previewPdf('@item.FilePath')">
                                                    <i class="fas fa-eye me-1"></i>Xem
                                                </button>
                                            }

                                            <!-- Nút Tải -->
                                            @if (!string.IsNullOrEmpty(item.FilePath))
                                            {
                                                <a asp-action="Download" asp-route-filePath="@item.FilePath" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-download me-1"></i>Tải
                                                </a>
                                            }

                                            <!-- Nút Xem chi tiết -->
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="showDetail('@item.Id')">
                                                <i class="fas fa-info-circle me-1"></i>Chi tiết
                                            </button>

                                            <!-- Nút Sửa và Xóa - CHỈ ADMIN -->
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                                    <i class="fas fa-edit me-1"></i>Sửa
                                                </a>

                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa văn bản này vĩnh viễn không?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash-alt me-1"></i>Xóa
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem trước PDF -->
<div class="modal fade" id="pdfPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content rounded-4 overflow-hidden">
            <div class="modal-header bg-gradient-primary text-white" style="background: linear-gradient(135deg, #0b5e7c 0%, #1a7a9e 100%);">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-file-pdf me-2"></i>Xem trước tài liệu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="pdfPreviewFrame" src="" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Modal Phóng to QR -->
<div class="modal fade" id="qrZoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 text-center p-3">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold"><i class="fas fa-qrcode me-2"></i>Mã QR</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <img id="qrZoomImage" src="" alt="Zoomed QR" class="img-fluid rounded-2" />
                <p class="text-muted mt-2 mb-0 small">Quét mã để tải tài liệu</p>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem chi tiết -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-info-circle text-primary me-2"></i>Chi tiết tài liệu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview PDF
        function previewPdf(filePath) {
            document.getElementById('pdfPreviewFrame').src = filePath;
            var pdfModal = new bootstrap.Modal(document.getElementById('pdfPreviewModal'));
            pdfModal.show();
        }

        document.getElementById('pdfPreviewModal').addEventListener('hidden.bs.modal', function () {
            document.getElementById('pdfPreviewFrame').src = '';
        });

        // Zoom QR
        function zoomQr(imgSrc) {
            document.getElementById('qrZoomImage').src = imgSrc;
            var qrModal = new bootstrap.Modal(document.getElementById('qrZoomModal'));
            qrModal.show();
        }

        // Xem chi tiết
        function showDetail(id) {
            var detailModal = new bootstrap.Modal(document.getElementById('detailModal'));
            var content = document.getElementById('detailContent');

            // Hiển thị loading
            content.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="mt-2 text-muted">Đang tải thông tin tài liệu...</p>
                </div>
            `;

            detailModal.show();

            // Gọi API lấy chi tiết
            fetch(`/Document/Details/${id}`)
                .then(response => response.text())
                .then(html => {
                    content.innerHTML = html;
                })
                .catch(error => {
                    content.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Không thể tải thông tin. Vui lòng thử lại sau.
                        </div>
                    `;
                });
        }

        // Tự động submit form khi chọn category hoặc thay đổi ngày
        document.querySelector('select[name="category"]').addEventListener('change', function() {
            document.getElementById('filterForm').submit();
        });

        // Debounce cho tìm kiếm
        let searchTimeout;
        document.querySelector('input[name="searchString"]').addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                document.getElementById('filterForm').submit();
            }, 500);
        });
    </script>
    <script>
        async function toggleStar(docId) {
            try {
                const response = await fetch(`/Document/ToggleFavorite?documentId=${docId}`, { method: 'POST' });
                const result = await response.json();

                const icon = document.getElementById(`star-${docId}`);
                if (result.isFavorite) {
                    icon.className = 'bi bi-star-fill text-warning fs-5';
                } else {
                    icon.className = 'bi bi-star text-secondary fs-5';
                }
            } catch (error) {
                console.error("Lỗi khi lưu tài liệu:", error);
            }
        }
    </script>
}