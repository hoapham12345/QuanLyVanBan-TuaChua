@model IEnumerable<DocManager.Models.Document>

@{
    ViewData["Title"] = "Tài liệu đã lưu";
}

<div class="container my-4">
    <h2 class="mb-4"><i class="bi bi-star-fill text-warning me-2"></i> Kho Tài liệu Cá nhân</h2>
    
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted mt-5">
                <i class="bi bi-folder-x display-1 d-block mb-3"></i>
                <h4>Bạn chưa lưu tài liệu nào.</h4>
                <p>Hãy quay lại trang Tra cứu và bấm vào biểu tượng ngôi sao để lưu trữ tài liệu quan trọng nhé!</p>
                <a asp-action="Index" class="btn btn-primary mt-2">Về trang Tra cứu</a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 border-top border-warning border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-info text-dark">@item.Category</span>
                                <small class="text-muted"><i class="bi bi-clock"></i> @item.IssueDate.ToString("dd/MM/yyyy")</small>
                            </div>
                            <h5 class="card-title fw-bold text-dark">@item.DocumentNumber</h5>
                            <p class="card-text text-muted line-clamp-2">@item.Title</p>
                        </div>
                        <div class="card-footer bg-white border-0 text-end pb-3">
                            <a asp-action="Download" asp-route-filePath="@item.FilePath" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-cloud-download"></i> Xem tài liệu
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>